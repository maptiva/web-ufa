---
import { Image } from 'astro:assets';

// Las 17 fotos optimizadas (scripts/optimizar-galeria.mjs).
const mods = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galeria/*.webp',
  { eager: true },
);
const fotos = Object.keys(mods)
  .sort()
  .map((k) => mods[k].default);
---

<section class="galeria" id="galeria">
  <div class="container">
    <h2>Antes y después</h2>
    <p class="nota">Trabajos reales de UFA, con perritos reales.</p>
    <div class="masonry">
      {fotos.map((img, i) => (
        <figure>
          <Image
            src={img}
            alt={`Trabajo de UFA — foto ${i + 1}`}
            widths={[600, 900]}
            sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
            format="webp"
            quality={76}
            loading="lazy"
            class="foto"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .galeria {
    background: var(--cream-2);
    padding-block: clamp(3rem, 8vh, 5.5rem);
  }
  .galeria h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    font-weight: 900;
    margin: 0 0 0.4rem;
  }
  .nota {
    color: var(--ink-soft);
    margin: 0 0 2rem;
    font-size: 1.05rem;
  }
  .masonry {
    columns: 3;
    column-gap: 1rem;
  }
  .masonry figure {
    margin: 0 0 1rem;
    break-inside: avoid;
  }
  .foto {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  @media (max-width: 900px) {
    .masonry {
      columns: 2;
    }
  }
  @media (max-width: 560px) {
    .masonry {
      columns: 1;
    }
  }
</style>
