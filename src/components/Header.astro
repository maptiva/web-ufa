---
import { WA_RESERVA } from '../config';

const links = [
  { href: '#marisa', label: 'Marisa' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#diferencia', label: 'La diferencia' },
  { href: '#galeria', label: 'Galería' },
  { href: '#opiniones', label: 'Opiniones' },
  { href: '#preguntas', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#inicio" class="logo" aria-label="UFA inicio">🐾 UFA</a>
    <nav class="nav" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-wa btn-sm" href={WA_RESERVA} target="_blank" rel="noopener">
      WhatsApp
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 247, 237, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(74, 44, 26, 0.12);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.7rem;
  }
  .logo {
    font-weight: 900;
    font-size: 1.35rem;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .nav {
    display: flex;
    gap: 1.1rem;
  }
  .nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .nav a:hover {
    color: var(--terra);
  }
  .btn-sm {
    padding: 0.55rem 1.15rem;
    font-size: 0.95rem;
  }
  /* TODO v0: menú hamburguesa en mobile */
  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }
</style>
