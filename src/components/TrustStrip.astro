---
const items = [
  { icon: 'medal', text: '35 años de oficio' },
  { icon: 'shield', text: 'Sin bozales · Sin jaulas' },
  { icon: 'heart', text: 'Especialidad en viejitos y cachorros' },
  { icon: 'pin', text: 'Paraná · traslados y domicilios' },
];
---

<section class="trust" aria-label="Por qué UFA">
  <div class="container trust-row">
    {items.map((i) => (
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">
          {i.icon === 'medal' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="9" r="5"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/></svg>
          )}
          {i.icon === 'shield' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z"/><path d="M9.5 12l2 2 3.5-4"/></svg>
          )}
          {i.icon === 'heart' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
          )}
          {i.icon === 'pin' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10z"/><circle cx="12" cy="11" r="2"/></svg>
          )}
        </span>
        <strong>{i.text}</strong>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    background: var(--cream-2);
    border-block: 1px solid rgba(74, 44, 26, 0.1);
  }
  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: center;
    padding-block: 1.1rem;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.98rem;
  }
  .trust-icon {
    display: inline-flex;
    width: 1.7rem;
    height: 1.7rem;
    color: var(--terra);
    flex: none;
  }
  .trust-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
